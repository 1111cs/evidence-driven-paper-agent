# Spring profile and persistence
SPRING_PROFILES_ACTIVE=external
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:54333/paper_agent
SPRING_DATASOURCE_USERNAME=paper_agent
SPRING_DATASOURCE_PASSWORD=paper_agent

# AgentScope / DeepSeek
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
PAPER_AGENT_MAX_ITERATIONS=10
PAPER_AGENT_TOOL_TIMEOUT=PT10M

# Alibaba Cloud Bailian knowledge base
PAPER_KNOWLEDGE_ENABLED=true
PAPER_KNOWLEDGE_ENDPOINT=<your-bailian-retrieve-endpoint>
PAPER_KNOWLEDGE_INDEX_ID=<your-bailian-index-id>
PAPER_KNOWLEDGE_API_KEY=<your-bailian-api-key>
PAPER_KNOWLEDGE_TOP_K=5

# HTTP
SERVER_PORT=8123
